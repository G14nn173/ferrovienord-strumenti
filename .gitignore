# cache di build dello starter
/.vinext/

# configurazione locale della macchina (permessi, percorsi)
/.claude/settings.local.json

# artefatto rigenerabile dalla cartella portable/
/FERROVIENORD-Mappa-V1-portable.zip

# identificativo di progetto legato all'account, inutile nel repo
/.openai/
